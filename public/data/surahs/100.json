{
  "number": 100,
  "name": "Al-Aadiyaat",
  "arabicName": "سُورَةُ العَادِيَاتِ",
  "meaning": "Kuda Perang",
  "revelation": "MECCAN",
  "totalAyah": 11,
  "bismillahPre": true,
  "ayahs": [
    {
      "number": 1,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا",
      "translation": "Demi kuda perang yang berlari kencang dengan terengah-engah,",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100001.mp3"
    },
    {
      "number": 2,
      "text": "فَٱلْمُورِيَٰتِ قَدْحًۭا",
      "translation": "dan kuda yang mencetuskan api dengan pukulan (kuku kakinya),",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100002.mp3"
    },
    {
      "number": 3,
      "text": "فَٱلْمُغِيرَٰتِ صُبْحًۭا",
      "translation": "dan kuda yang menyerang dengan tiba-tiba di waktu pagi,",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100003.mp3"
    },
    {
      "number": 4,
      "text": "فَأَثَرْنَ بِهِۦ نَقْعًۭا",
      "translation": "maka ia menerbangkan debu,",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100004.mp3"
    },
    {
      "number": 5,
      "text": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "translation": "dan menyerbu ke tengah-tengah kumpulan musuh,",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100005.mp3"
    },
    {
      "number": 6,
      "text": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ",
      "translation": "sesungguhnya manusia itu sangat ingkar, tidak berterima kasih kepada Tuhannya,",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100006.mp3"
    },
    {
      "number": 7,
      "text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ",
      "translation": "dan sesungguhnya manusia itu menyaksikan (sendiri) keingkarannya,",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100007.mp3"
    },
    {
      "number": 8,
      "text": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "translation": "dan sesungguhnya dia sangat bakhil karena cintanya kepada harta.",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100008.mp3"
    },
    {
      "number": 9,
      "text": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "translation": "Maka apakah dia tidak mengetahui apabila dibangkitkan apa yang ada di dalam kubur,",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100009.mp3"
    },
    {
      "number": 10,
      "text": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "translation": "dan dilahirkan apa yang ada di dalam dada,",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100010.mp3"
    },
    {
      "number": 11,
      "text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ",
      "translation": "sesungguhnya Tuhan mereka pada hari itu Maha Mengetahui keadaan mereka.",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/100011.mp3"
    }
  ]
}